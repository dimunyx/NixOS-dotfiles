// NOTE: `Niri` window rules configuration file

// Decoration
window-rule {
	geometry-corner-radius 16
	clip-to-geometry true
	background-effect {
        	blur true
		xray false
    	}
}
window-rule {
    	match is-active=true
    	opacity 1.0
}

window-rule {
    	match is-active=false
    	opacity 0.75
}

// Apps
window-rule {
	match app-id="org.gnome.Calculator"
	open-floating true
}
window-rule {
	match app-id="discord"
	open-maximized true
}
window-rule {
	match app-id="zen"
	open-maximized true
}
window-rule {
	match app-id="dev.noctalia.Noctalia"
	open-maximized true
}
window-rule {
	match app-id="io.github.elyprismlauncher.ElyPrismLauncher"
	open-maximized true
}
window-rule {
	match app-id="Minecraft 1.8.9"
	open-fullscreen true
}
window-rule {
	match app-id="com.ktechpit.whatsie"
	open-maximized true
}
window-rule {
	match app-id="blender"
	open-maximized true
}
window-rule {
	match app-id="org.gnome.Boxes"
	open-maximized true
}
window-rule {
	match app-id="org.telegram.desktop"
	open-maximized true
}
window-rule {
	match app-id="spotify"
	open-maximized true
}
window-rule {
	match app-id="org.vinegarhq.Sober"
	open-fullscreen true
}
