layout {

    focus-ring {
        active-color   "#8caaee"
        inactive-color "#000000"
        urgent-color   "#e78284"
    }

    border {
        active-color   "#8caaee"
        inactive-color "#000000"
        urgent-color   "#e78284"
    }

    shadow {
        color "#23263470"
    }

    tab-indicator {
        active-color   "#8caaee"
        inactive-color "#0b41bd"
        urgent-color   "#e78284"
    }

    insert-hint {
        color "#8caaee80"
    }
}

recent-windows {
    highlight {
        active-color "#8caaee"
        urgent-color "#e78284"
    }
}
